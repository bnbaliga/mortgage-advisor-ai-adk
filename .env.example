# Copy to .env and fill in. Never commit .env.

# Gemini Developer API (AI Studio) — not Vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_key

# Live model and voice
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Aoede
# MORTGAGE_VOICE=Aoede            # overrides LIVE_VOICE for the mortgage agent

# Personas
# MORTGAGE_AGENT_NAME=Mac
# SERVICING_AGENT_NAME=Ivy
# MORTGAGE_ACCENT=
# MORTGAGE_GREETING=1             # 0 = don't greet on connect

# Optional token prices (USD per 1M tokens) for the cost meter
# TOKEN_PRICE_IN_TEXT=
# TOKEN_PRICE_IN_AUDIO=
# TOKEN_PRICE_OUT_TEXT=
# TOKEN_PRICE_OUT_AUDIO=

# Optional path overrides (defaults shown)
# MORTGAGE_DATA_DIR=data/mortgage
# MORTGAGE_FRONTEND_DIR=src/frontend
# MORTGAGE_MIGRATIONS_DIR=migrations
# MORTGAGE_SERVICING_DB=data/mortgage/servicing.db
# MORTGAGE_KNOWLEDGE_DB=data/mortgage/passages.db
# LOG_LEVEL=INFO

# Silences ADK OpenTelemetry output
OTEL_SDK_DISABLED=true
